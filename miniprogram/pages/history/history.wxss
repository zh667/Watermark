/* === 历史记录页 === */
.header-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 10rpx;
}

.clear-btn {
  padding: 16rpx 24rpx;
  font-size: 26rpx;
}

/* 记录项 */
.history-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  gap: 20rpx;
}

.history-cover {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.history-placeholder {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  background-color: var(--bg-primary);
  border: 1rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 22rpx;
}

.history-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.history-title {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-author {
  font-size: 24rpx;
  margin-bottom: 4rpx;
}

.history-time {
  font-size: 22rpx;
}

/* 操作按钮 */
.history-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex-shrink: 0;
}

.action-btn {
  padding: 8rpx 20rpx;
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
  text-align: center;
  font-size: 24rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
}
