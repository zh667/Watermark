/* === Claude 暖色设计 Tokens === */
page {
  --bg-primary: #f0eee6;
  --bg-secondary: #faf9f5;
  --text-primary: #1a1916;
  --text-secondary: #6b6862;
  --accent: #cc785c;
  --accent-dark: #bd5d3a;
  --border: #e3e0d8;

  background-color: var(--bg-primary);
  color: var(--text-primary);
  font-family: -apple-system, 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  line-height: 1.7;
}

/* === 通用容器 === */
.container {
  padding: 40rpx 36rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* === 卡片 === */
.card {
  background-color: var(--bg-secondary);
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

/* === 主按钮 === */
.btn-primary {
  background-color: var(--accent);
  color: #ffffff;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx 0;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  width: 100%;
  text-align: center;
  line-height: 1.5;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  background-color: var(--accent-dark);
}

/* === 次级按钮 === */
.btn-secondary {
  background-color: transparent;
  color: var(--accent);
  border: 1rpx solid var(--accent);
  border-radius: 12rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
  width: 100%;
  text-align: center;
  line-height: 1.5;
}

.btn-secondary::after {
  border: none;
}

.btn-secondary:active {
  background-color: rgba(204, 120, 92, 0.08);
}

/* === 文字工具类 === */
.text-secondary {
  color: var(--text-secondary);
}

.text-accent {
  color: var(--accent);
}

.text-center {
  text-align: center;
}

/* === 分隔线 === */
.divider {
  height: 1rpx;
  background-color: var(--border);
  margin: 24rpx 0;
}

/* === 页面标题 === */
.page-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 40rpx;
}
